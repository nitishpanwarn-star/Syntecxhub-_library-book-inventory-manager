
import json
import os

DATA_FILE = "books.json"


class Book:
    def __init__(self, book_id, title, author, issued=False, issued_to=""):
        self.book_id = str(book_id)
        self.title = title
        self.author = author
        self.issued = issued
        self.issued_to = issued_to

    def to_dict(self):
        return {
            "book_id": self.book_id,
            "title": self.title,
            "author": self.author,
            "issued": self.issued,
            "issued_to": self.issued_to
        }

    @classmethod
    def from_dict(cls, data):
        return cls(
            data["book_id"],
            data["title"],
            data["author"],
            data.get("issued", False),
            data.get("issued_to", "")
        )


class Library:
    def __init__(self):
        self.books = {}
        self.load_books()

    def load_books(self):
        if not os.path.exists(DATA_FILE):
            self.save_books()
            return

        try:
            with open(DATA_FILE, "r", encoding="utf-8") as file:
                data = json.load(file)

            self.books = {
                str(item["book_id"]): Book.from_dict(item)
                for item in data
            }
        except (json.JSONDecodeError, KeyError, TypeError):
            print("Error reading data. Starting with empty inventory.")
            self.books = {}

    def save_books(self):
        with open(DATA_FILE, "w", encoding="utf-8") as file:
            json.dump(
                [book.to_dict() for book in self.books.values()],
                file,
                indent=4
            )

    def add_book(self, book_id, title, author):
        book_id = str(book_id).strip()
        title = title.strip()
        author = author.strip()

        if not book_id or not title or not author:
            print("All fields are required.")
            return

        if book_id in self.books:
            print("Book ID already exists.")
            return

        self.books[book_id] = Book(book_id, title, author)
        self.save_books()
        print("Book added successfully!")

    def search_books(self, query):
        query = query.strip().casefold()

        results = [
            book for book in self.books.values()
            if query in book.title.casefold()
            or query in book.author.casefold()
            or query == book.book_id.casefold()
        ]

        if not results:
            print("No books found.")
            return

        for book in results:
            self.display_book(book)

    def display_book(self, book):
        status = (
            f"Issued to {book.issued_to}"
            if book.issued else "Available"
        )

        print(
            f"ID: {book.book_id} | "
            f"Title: {book.title} | "
            f"Author: {book.author} | "
            f"Status: {status}"
        )

    def show_all_books(self):
        if not self.books:
            print("No books in the library.")
            return

        for book in self.books.values():
            self.display_book(book)

    def issue_book(self, book_id, borrower):
        book = self.books.get(str(book_id).strip())

        if book is None:
            print("Book not found.")
        elif book.issued:
            print("Book is already issued.")
        elif not borrower.strip():
            print("Borrower's name is required.")
        else:
            book.issued = True
            book.issued_to = borrower.strip()
            self.save_books()
            print("Book issued successfully!")

    def return_book(self, book_id):
        book = self.books.get(str(book_id).strip())

        if book is None:
            print("Book not found.")
        elif not book.issued:
            print("This book has not been issued.")
        else:
            book.issued = False
            book.issued_to = ""
            self.save_books()
            print("Book returned successfully!")

    def show_report(self):
        total = len(self.books)
        issued = sum(
            1 for book in self.books.values()
            if book.issued
        )

        print("\n--- Library Report ---")
        print("Total books:", total)
        print("Issued books:", issued)
        print("Available books:", total - issued)


def main():
    library = Library()

    while True:
        print("\n===== LIBRARY BOOK MANAGER =====")
        print("1. Add Book")
        print("2. Search Book")
        print("3. Issue Book")
        print("4. Return Book")
        print("5. Show All Books")
        print("6. Library Report")
        print("0. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            book_id = input("Enter book ID: ")
            title = input("Enter title: ")
            author = input("Enter author: ")
            library.add_book(book_id, title, author)

        elif choice == "2":
            query = input("Enter title, author, or ID: ")
            library.search_books(query)

        elif choice == "3":
            book_id = input("Enter book ID: ")
            borrower = input("Enter borrower's name: ")
            library.issue_book(book_id, borrower)

        elif choice == "4":
            book_id = input("Enter book ID: ")
            library.return_book(book_id)

        elif choice == "5":
            library.show_all_books()

        elif choice == "6":
            library.show_report()

        elif choice == "0":
            print("Thank you for using the Library Book Manager!")
            break

        else:
            print("Invalid choice. Try again.")


if __name__ == "__main__":
    main()
